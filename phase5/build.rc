#!/bin/rc
# build.rc - build the translated OpenTTD on 9legacy and run it
#	Run by run9legacy.sh (script=phase5/build.rc), with this
#	repository on /n/ottd, as ../phase2/build.rc on 9front:
#	FreeType by its own mkfile with 9legacy's 6c (in a tree of its own,
#	../phase1/work/freetype; 9front builds in a copy, freetype9f), then work/tu
#	with mk SYS=9legacy
#	(objects in work/tu/obj.9legacy), then openttd -h and the gate's
#	scenarios (world, regression) for $ticks ticks (default 100), their
#	saves in ../phase5/work/out (run9legacy.sh compares them).  Output: what each step says.
rfork en
r=/n/ottd
tu=$r/phase2/work/tu
o=$tu/obj.9legacy
out=$r/phase5/work/out
data=$r/phase1/work
if(~ $#ticks 0)
	ticks=100
mkdir -p $out
date

ft=$data/freetype
if(! @{cd $ft && mk >$out/ft.log >[2=1]}){
	echo freetype mk FAILED
	grep -v '^warning' $out/ft.log | tail -20 | awk '{print substr($0, 1, 300)}'
	exit freetype
}
echo freetype: built

cd $tu
if(! mk 'SYS=9legacy' >$out/mk.log >[2=1]){
	echo mk FAILED
	grep -v '^warning' $out/mk.log | tail -30 | awk '{print substr($0, 1, 300)}'
	exit mk
}
echo mk: `{grep -c '^6[cl] ' $out/mk.log} commands
date

# the data OpenTTD finds next to its executable
for(d in lang ai game baseset media bin){
	mkdir -p $o/$d
	bind $data/build-p9/$d $o/$d
}
$o/6.openttd -h >$out/h.txt >[2=1]
echo openttd -h status $status
sed 1q $out/h.txt

# the gate's scenarios, as build.rc plays them: their saves in $out
fn play {
	d=/tmp/$1
	mkdir -p $d/lib/openttd/baseset
	bind $data/data/openttd/baseset $d/lib/openttd/baseset
	{
		echo '[misc]'
		echo 'savegame_format = none'
		echo 'prefer_sprite_font = true'
		echo '[gui]'
		echo 'autosave = off'
		echo 'autosave_on_exit = true'
		echo '[game_creation]'
		echo 'town_name = english'
		echo '[ai_players]'
		echo 'none ='
	} >$d/openttd.cfg
	switch($1){
	case world
		game=(-G 1234567 -g)
	case regression
		game=(-g $data/regression.sav)
	}
	home=$d $o/6.openttd -x -c $d/openttd.cfg -v 'null:ticks='^$ticks -s null -m null $game >$out/$1.log >[2=1]
	echo $1 status $status
	rm -f $out/$1.sav
	if(test -f $d/save/autosave/exit.sav){
		cp $d/save/autosave/exit.sav $out/$1.sav
		echo $1: saved
	}
}
play world
play regression
# the threads' test (../phase0/tests_tu/t2), as on 9front: ten runs,
# each the native build's output
@{
	cd $r/phase0/out/tu/t2
	if(! mk 'SYS=9legacy' >$out/t2.mk.log >[2=1]){
		echo t2 mk FAILED
		tail -10 $out/t2.mk.log
		exit t2
	}
	n=0
	for(i in `{seq 1 10}){
		obj.9legacy/6.t2 >/tmp/t2.out >[2=1]
		if(cmp -s /tmp/t2.out $r/phase0/tests_tu/t2/expected)
			n=`{echo $n + 1 | hoc}
	}
	echo t2: $n of 10 as expected
}

# stop pid, as build.rc: the interrupt, which the game takes as a quit
# request; its status, and what it left behind
fn stop {
	echo -n interrupt >/proc/$1/note >[2]/dev/null
	i=0
	while(test -e /proc/$1 && test $i -lt 10){
		sleep 1
		i=`{echo $i + 1 | hoc}
	}
	if(test -e /proc/$1){
		echo $1 did not quit on interrupt: killed
		# where it is, for a look: every process of the program
		for(p in `{ps | grep ' 6\.openttd$' | awk '{print $2}'}){
			echo '==' $p `{cat /proc/$p/status | awk '{print $1, $2, $3}'}
			echo 'lstk()' | acid $p >[2=1] | sed 40q
		} >$out/stuck.txt >[2=1]
		echo kill >/proc/$1/notepg >[2]/dev/null
	}
	if not{
		wait $1
		if(~ $status *interrupt*)
			echo killed by the interrupt: $status
		if not
			echo quit on interrupt
	}
	sleep 2
	left=`{ps | grep -c ' 6\.openttd$'}
	if(! ~ $left 0){
		echo left behind: $left processes
		ps -a | grep '6\.openttd' | grep -v grep
	}
}

# a dedicated server for the host's client (run9legacy.sh), as build.rc's
d=$out/ded
rm -rf $d
mkdir -p $d/lib/openttd/baseset
bind $data/data/openttd/baseset $d/lib/openttd/baseset
{
	echo '[misc]'
	echo 'savegame_format = none'
	echo 'prefer_sprite_font = true'
	echo '[gui]'
	echo 'autosave = off'
	echo '[network]'
	echo 'server_name = 9legacy'
} >$d/openttd.cfg
# 4e's rc forks again for home=... before a command (and for @{...}):
# $apid would be another rc's, not the game's, and the interrupt would
# miss it.  The game is found as build.rc finds it in rio: by ps, while
# it is the only one (its helpers start later)
home=$d $o/6.openttd -D -x -c $d/openttd.cfg -d 'net=3' >$d/log >[2=1] &
pid=()
i=0
while(~ $#pid 0 && test $i -lt 60){
	sleep 1
	pid=`{ps | grep ' 6\.openttd$' | awk '{print $2}' | sed 1q}
	i=`{echo $i + 1 | hoc}
}
i=0
while(! grep -s 'starting game' $d/log && test $i -lt 300){
	sleep 1
	i=`{echo $i + 1 | hoc}
}
date >$d/ready
echo dedicated server up
i=0
while(! test -f $d/done && test $i -lt 600){
	sleep 1
	i=`{echo $i + 1 | hoc}
}
stop $pid
# with $gui, the game on the bare screen (VESA, no rio) for $guitime
# seconds (default 60), the screen at each t of $guishots (default 30)
# as $out/screen.t.png: ../phase3/screenshot.c, compiled here
if(~ $gui 1){
	if(~ $#guitime 0)
		guitime=60
	if(~ $#guishots 0)
		guishots=30
	# the devices termrc binds after termrc.local: #P holds realmode,
	# through which aux/vga asks the VESA BIOS for its modes
	for(i in f t m v L P u U '$' i)
		bind -a '#'^$i /dev >[2]/dev/null
	aux/mouse ps2
	# as termrc for monitor=vesa: the VESA BIOS's real-mode calls go
	# through aux/realemu (amd64 cannot run them)
	aux/realemu
	aux/vga -m vesa -l 1024x768x32 >$out/vga.log >[2=1]
	echo vga status $status
	6c -o /tmp/screenshot.6 $r/phase3/screenshot.c && 6l -o /tmp/screenshot /tmp/screenshot.6
	# with $guiaudio 1, the game picks its sound and music drivers, as
	# when one runs it: the Plan 9 ones where they can work (on amd64 no
	# /dev/audio, and no MIDI player), else null (issue #29).  Named on
	# the command line (-s plan9), a driver that cannot start stops the game
	audio=(-s null -m null)
	if(~ $guiaudio 1)
		audio=()
	d=$out/gui
	rm -rf $d
	mkdir -p $d/lib/openttd/baseset
	bind $data/data/openttd/baseset $d/lib/openttd/baseset
	{
		echo '[misc]'
		echo 'savegame_format = none'
		echo 'prefer_sprite_font = true'
		echo '[gui]'
		echo 'autosave = off'
		echo 'autosave_on_exit = true'
	} >$d/openttd.cfg
	# the draw shim says when its window is up (p9drawshot: /tmp/shot.ready;
	# no shots of its own): then the host's input begins (gui/shot.ready)
	rm -f /tmp/shot.ready
	if(~ $guirio 1){
		# in a rio window (40,40 to 840,640), as build.rc's guirio; with
		# $guifocus (t1 t2) another window is made current at t1, the
		# game's again at t2 (win9f.c's /dev/wctl)
		{
			echo '#!/bin/rc'
			echo 'home='$d' p9drawshot=/tmp/shot p9drawshotat=100000' \
				$o/6.openttd -x -c $d/openttd.cfg -v plan9 $audio -d '''driver=3''' '>'$d/log '>[2=1]'
		} >/tmp/game
		{
			echo '#!/bin/rc'
			echo window -r 40 40 840 640 /tmp/game
			if(~ $#guifocus 2){
				echo '{'
				echo '	sleep' $guifocus(1)
				echo '	window -r 860 40 1010 300 rc'
				echo '	sleep' `{echo $guifocus(2) - $guifocus(1) | hoc}
				echo '	for(w in /dev/wsys/* /mnt/wsys/wsys/*)'
				echo '		if(grep -s ''^OpenTTD'' $w/label >[2]/dev/null)'
				echo '			echo current >$w/wctl'
				echo '} &'
			}
		} >/tmp/rioinit
		chmod +x /tmp/game /tmp/rioinit
		rio -i /tmp/rioinit </dev/null >/dev/null >[2=1] &
	}
	# (4e's rc takes no if not after that block)
	if(! ~ $guirio 1)
		home=$d p9drawshot=/tmp/shot p9drawshotat=100000 $o/6.openttd -x -c $d/openttd.cfg -v plan9 $audio -d 'driver=3' >$d/log >[2=1] &
	pid=()
	i=0
	while(~ $#pid 0 && test $i -lt 120){
		sleep 1
		pid=`{ps | grep ' 6\.openttd$' | awk '{print $2}' | sed 1q}
		i=`{echo $i + 1 | hoc}
	}
	while(! test -f /tmp/shot.ready && test -e /proc/$pid)
		sleep 1
	touch $d/shot.ready
	start=`{date -n}
	for(t in $guishots){
		while(test `{date -n} -lt `{echo $start + $t | hoc})
			sleep 1
		/tmp/screenshot | topng >$out/screen.$t.png
		echo screenshot $t
	}
	while(test `{date -n} -lt `{echo $start + $guitime | hoc})
		sleep 1
	stop $pid
	if(~ $guirio 1)
		slay rio | rc
	echo video driver log:
	grep -v '^$' $d/log | tail -8
}
date
