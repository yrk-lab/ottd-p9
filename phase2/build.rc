#!/bin/rc
# build.rc - build the translated OpenTTD on 9front, in place, and run it
#	Run at boot by run9front.sh, with the repository mounted on
#	/n/ottd.  Builds work/tu (../phase0/tu/build.sh's tree, translated
#	on Linux) with mk SYS=9front: only what changed since the last
#	boot is compiled, objects in work/tu/obj.9front.  Then, for what
#	run9front.sh prepared in work/9f (the results go there too):
#	- runs each socket test (work/nettest/name.c) against the
#	  runtime's objects, output in 9f/name.out;
#	- runs openttd -h;
#	- plays the Phase 1 gate scenarios for $ticks ticks (default
#	  100000): 9f/gate/world.sav, 9f/gate/regression.sav;
#	- with 9f/gui/openttd.cfg, runs the game with the Plan 9 video
#	  driver on the screen for $guitime seconds (default 120), the
#	  draw shim saying when it is up (9f/gui/shot.ready), and the
#	  screen (topng) 9f/gui/screen.t.png t seconds after, for each t
#	  in $guishots;
#	  a run that faults leaves its stack in 9f/gui/stack;
#	- with 9f/ded/openttd.cfg, starts a dedicated server (port 3979),
#	  says so in 9f/ded/ready, and stops it when the host's client is
#	  done (9f/ded/done) or after $dedtime seconds (default 600).
rfork en
r=/n/ottd
tu=$r/phase2/work/tu
o=$tu/obj.9front
out=$r/phase2/work/9f
data=$r/phase1/work
date

cd $tu
if(! mk 'SYS=9front' >$out/mk.log >[2=1]){
	echo mk FAILED
	grep -v '^warning' $out/mk.log | tail -20 | cut -c1-300
	exit mk
}
echo mk: `{grep -c '^6[cl] ' $out/mk.log} commands
date

# the socket tests, against the runtime
rt=($o/rt_p9.6 $o/libc_p9.6 $o/os_p9.6 $o/os9f.6 $o/thread_p9.6 $o/thread9f.6 $o/net_p9.6 $o/net9f.6)
for(f in `{ls $r/phase2/work/nettest/*.c >[2]/dev/null}){
	n=`{basename $f .c}
	if(6c -w -I$r/phase0/plan9/shim -o $out/$n.6 $f >$out/$n.log >[2=1] && 6l -o $out/$n.x $out/$n.6 $rt >>$out/$n.log >[2=1]){
		$out/$n.x >$out/$n.out >[2=1]
		echo $n status $status
	}
	if not{
		echo $n: BUILD FAILED
		sed 5q $out/$n.log
	}
}

# the data OpenTTD finds next to its executable
for(d in lang ai game baseset media bin){
	mkdir -p $o/$d
	bind $data/build-p9/$d $o/$d
}
$o/6.openttd -h >$out/h.txt >[2=1]
echo openttd -h status $status
sed 3q $out/h.txt

# a fresh home d with the gate's base set: the game's data and
# personal directory is $home/lib/openttd
fn personal {
	rm -rf $1
	mkdir -p $1/lib/openttd/baseset
	bind $data/data/openttd/baseset $1/lib/openttd/baseset
}

# play s: the Phase 1 gate scenario s (as phase1/gate.sh); the exit
# save is gate/s.sav
fn play {
	s=$1
	d=$out/gate/$s
	personal $d
	rm -f $d.sav
	{
		echo '[misc]'
		echo 'savegame_format = none'
		echo '[gui]'
		echo 'autosave = off'
		echo 'autosave_on_exit = true'
		echo '[game_creation]'
		echo 'town_name = english'
		echo '[ai_players]'
		echo 'none ='
	} >$d/openttd.cfg
	switch($s){
	case world
		game=(-G $seed -g)
	case regression
		game=(-g $data/regression.sav)
	}
	home=$d $o/6.openttd -x -c $d/openttd.cfg \
		-v null:ticks^'='^$ticks -s null -m null $game >$d/log >[2=1]
	st=$status
	if(test -f $d/save/autosave/exit.sav){
		cp $d/save/autosave/exit.sav $d.sav
		echo gate/$s: done status $st
	}
	if not{
		echo gate/$s: FAILED status $st
		tail -5 $d/log
	}
}

if(~ $#ticks 0)
	ticks=100000
seed=1234567
mkdir -p $out/gate
for(s in world regression)
	play $s
date

# the video driver, on the screen, for $guitime seconds (default 120):
# gui/shot.ready says the draw shim's window is up (run9front.sh sends
# its input from then), and gui/screen.t.png is the screen t seconds
# after, for each t in $guishots (default 20).  With $guirio 1, the game
# runs in a rio window (and $guiresize: resized after that many seconds)
if(test -f $out/gui/openttd.cfg){
	d=$out/gui
	if(~ $#guitime 0)
		guitime=120
	if(~ $#guishots 0)
		guishots=20
	# no rio, no /dev/screen: ../phase3/screenshot.c reads the screen
	6c -o /tmp/screenshot.6 $r/phase3/screenshot.c && 6l -o /tmp/screenshot /tmp/screenshot.6
	cp $d/openttd.cfg /tmp/gui.cfg
	personal $d
	mv /tmp/gui.cfg $d/openttd.cfg
	# one word: rc would export a list with NULs between
	# the shim says when its window is up (in /tmp: it takes no shots,
	# they are the screen's (screenshot | topng), taken on time whatever the game
	# does); the ready file where the host sees it
	rm -f /tmp/shot.* /tmp/screen.*
	# the plumber, as a session has it, and what is plumbed to the web
	# port (the game's links: plumb9f.c) in gui/plumbed
	if(! test -e /mnt/plumb/send)
		plumber
	cat /mnt/plumb/web >$d/plumbed >[2]/dev/null &
	plumbcat=$apid
	# with $guiaudio 1, the Plan 9 sound and music drivers (/dev/audio;
	# music by games/dmid, with 9front's instrument bank)
	audio=(-s null -m null)
	if(~ $guiaudio 1)
		audio=(-s plan9 -m plan9)
	cmd=($o/6.openttd -x -c $d/openttd.cfg -v plan9 $audio -d driver^'='^3)
	if(~ $guirio 1){
		# in a rio window, as one runs it: rio's -i script opens the
		# window; with $guiresize, a process finds it in wsys by its
		# label (the game's caption) and, $guiresize seconds after,
		# makes it bigger through its wctl
		{
			echo '#!/bin/rc'
			# quoted: a word with = in it is an assignment or an error to rc
			echo 'home='$d' p9drawshot=/tmp/shot p9drawshotat=100000' \
				$o/6.openttd -x -c $d/openttd.cfg -v plan9 $audio -d '''driver=3''' '>'$d/log '>[2=1]'
		} >/tmp/game
		{
			echo '#!/bin/rc'
			echo window -r 40 40 840 640 /tmp/game
			if(! ~ $#guiresize 0){
				echo '{'
				echo '	sleep' $guiresize
				echo '	for(w in /dev/wsys/* /mnt/wsys/wsys/*)'
				echo '		if(grep -s ''^OpenTTD'' $w/label >[2]/dev/null)'
				echo '			echo resize -r 40 40 1000 740 >$w/wctl'
				echo '} &'
			}
		} >/tmp/rioinit
		chmod +x /tmp/game /tmp/rioinit
		rio -i /tmp/rioinit </dev/null >/dev/null >[2=1] &
		rio=$apid
		pid=()
		i=0
		while(~ $#pid 0 && test $i -lt 120){
			sleep 1
			pid=`{ps | grep ' 6\.openttd$' | awk '{print $2}' | sed 1q}
			i=`{echo $i + 1 | hoc}
		}
	}
	if not{
		home=$d p9drawshot=/tmp/shot p9drawshotat=100000 \
			$cmd >$d/log >[2=1] &
		pid=$apid
	}
	while(! test -f /tmp/shot.ready && test -e /proc/$pid)
		sleep 1
	touch $d/shot.ready
	start=`{date -n}
	for(t in $guishots){
		while(test `{date -n} -lt `{echo $start + $t | hoc})
			sleep 1
		/tmp/screenshot | topng >/tmp/screen.$t.png
	}
	while(test `{date -n} -lt `{echo $start + $guitime | hoc})
		sleep 1
	# a faulted process is kept Broken: its stack, for the log
	if(ps | grep -s '^[^ ]+ +'^$pid^' .*Broken'){
		{
			echo 'lstk()'
			echo 'regs()'
			# a call through nil leaves no frame: the words around the stack top, as symbols
			echo 'sp=*SP-128; i=0; while i<64 do { a=fmt(sp+8*i, ''Y''); print(fmt(sp+8*i, ''Y''), " ", fmt(*a, ''a''), "\n"); i=i+1; }'
		} | acid $pid >$d/stack >[2=1]
		echo video driver: broken, stack in gui/stack
	}
	# the note group: libdraw's event processes hold /dev/mouse
	if(test -e /proc/$pid)
		echo kill >/proc/$pid/notepg
	if(~ $guirio 1)
		slay rio | rc
	echo kill >/proc/$plumbcat/note >[2]/dev/null
	sleep 1
	for(f in `{ls /tmp/screen.*.png >[2]/dev/null})
		cp $f $d/
	echo video driver log:
	grep -v '^$' $d/log | tail -10
}

# a dedicated server for the host's client
if(test -f $out/ded/openttd.cfg){
	d=$out/ded
	if(~ $#netdebug 0)
		netdebug=3
	if(~ $#dedtime 0)
		dedtime=600
	cp $d/openttd.cfg /tmp/ded.cfg
	personal $d
	mv /tmp/ded.cfg $d/openttd.cfg
	home=$d $o/6.openttd -D -x -c $d/openttd.cfg \
		-d net^'='^$netdebug >$d/log >[2=1] &
	pid=$apid
	# rc has no break: count in the condition
	i=0
	while(! grep -s 'starting game' $d/log && test $i -lt 300){
		sleep 1
		i=`{echo $i + 1 | hoc}
	}
	date >$d/ready
	echo dedicated server up
	i=0
	while(! test -f $d/done && test $i -lt $dedtime){
		sleep 1
		i=`{echo $i + 1 | hoc}
	}
	# the note group: libdraw's event processes hold /dev/mouse
	if(test -e /proc/$pid)
		echo kill >/proc/$pid/notepg
	sleep 1
	echo dedicated server log:
	grep -v '^$' $d/log | tail -20
}
