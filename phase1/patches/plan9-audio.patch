+ */
+
+/**
+ * @file plan9_m.cpp Music on Plan 9.
+ *
+ * The song, as a standard MIDI file, is played by an external pipeline
+ * (on 9front, games/dmid into games/opl3: phase0/plan9/audio9f.c), whose
+ * sound the mixer takes as its music source, so the music goes out with
+ * the sound effects through the Plan 9 sound driver.
+ */
+
+#include "../stdafx.h"
+#include "../mixer.h"
+#include "../debug.h"
+#include "../base_media_base.h"
+#include "midifile.hpp"
+#include "plan9_m.h"
+
+#include "../safeguards.h"
+
+extern "C" {
+	int p9music_play(char *file, int rate);
+	void p9music_stop(void);
+	int p9music_playing(void);
+	int p9music_read(short *buf, int frames);
+}
+
+static FMusicDriver_Plan9 iFMusicDriver_Plan9;
+
+static uint32_t _p9_music_rate; ///< The mixer's rate.
+static int _p9_music_volume = 127; ///< 0..127.
+static std::vector<int16_t> _p9_music_buf; ///< What the pipeline gave.
+
+/** The mixer's music source: the pipeline's sound, at the volume, added in. */
+static void RenderMusicStream(int16_t *buffer, size_t samples)
+{
+	if (_p9_music_buf.size() < 2 * samples) _p9_music_buf.resize(2 * samples);
+	int n = p9music_read(_p9_music_buf.data(), static_cast<int>(samples));
+	for (int i = 0; i < 2 * n; i++) {
+		buffer[i] = static_cast<int16_t>(Clamp(buffer[i] + _p9_music_buf[i] * _p9_music_volume / 127, INT16_MIN, INT16_MAX));
+	}
+}
+
+std::optional<std::string_view> MusicDriver_Plan9::Start(const StringList &)
+{
+	/* The rate is the Plan 9 sound driver's (44100 Hz, which games/opl3
+	 * plays at), or the mixer's default when another sound driver runs:
+	 * then the shim plays no song. */
+	_p9_music_rate = MxSetMusicSource(RenderMusicStream);
+	return std::nullopt;
+}
+
+void MusicDriver_Plan9::Stop()
+{
+	p9music_stop();
+	MxSetMusicSource(nullptr);
+}
+
+void MusicDriver_Plan9::PlaySong(const MusicSongInfo &song)
+{
+	std::string filename = MidiFile::GetSMFFile(song);
+	p9music_stop();
+	if (filename.empty()) return;
+	if (p9music_play(filename.data(), static_cast<int>(_p9_music_rate)) < 0) {
+		Debug(driver, 1, "plan9: cannot play {}", filename);
+	}
+}
+
+void MusicDriver_Plan9::StopSong()
+{
+	p9music_stop();
+}
+
+bool MusicDriver_Plan9::IsSongPlaying()
+{
+	return p9music_playing() != 0;
+}
+
+void MusicDriver_Plan9::SetVolume(uint8_t vol)
+{
+	_p9_music_volume = vol;
+}
