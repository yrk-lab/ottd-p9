+/** @file plan9_s.h Base for the Plan 9 sound driver. */
+
+#ifndef SOUND_PLAN9_H
+#define SOUND_PLAN9_H
+
+#include "sound_driver.hpp"
+
+/** The Plan 9 sound driver: /dev/audio, through a small C shim. */
+class SoundDriver_Plan9 : public SoundDriver {
+public:
+	std::optional<std::string_view> Start(const StringList &param) override;
+	void Stop() override;
+	void MainLoop() override;
+	std::string_view GetName() const override { return "plan9"; }
+};
+
+/** Factory for the Plan 9 sound driver. */
+class FSoundDriver_Plan9 : public DriverFactoryBase {
+public:
+	FSoundDriver_Plan9() : DriverFactoryBase(Driver::DT_SOUND, 9, "plan9", "Plan 9 Sound Driver") {}
+	std::unique_ptr<Driver> CreateInstance() const override { return std::make_unique<SoundDriver_Plan9>(); }
+};
+
+#endif /* SOUND_PLAN9_H */
