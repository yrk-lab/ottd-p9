+
+/**
+ * @file plan9_s.cpp Sound on Plan 9.
+ *
+ * There are no threads, so the mixer runs here, once a tick (MainLoop),
+ * as with Allegro: it mixes as much as the shim can take, a little
+ * ahead of what is playing, and the shim (phase0/plan9/audio9f.c on
+ * 9front) has a process of its own that writes it to /dev/audio.  The
+ * interface is C, ints and pointers only.
+ */
+
+#include "../stdafx.h"
+#include "../mixer.h"
+#include "../debug.h"
+#include "plan9_s.h"
+
+#include "../safeguards.h"
+
+extern "C" {
+	int p9audio_open(int rate);
+	int p9audio_space(void);
+	void p9audio_write(short *buf, int frames);
+	void p9audio_close(void);
+}
+
+static FSoundDriver_Plan9 iFSoundDriver_Plan9;
+
+static const int MIX_CHUNK = 1024; ///< Frames mixed at a time.
+static std::vector<int16_t> _p9_mix; ///< One chunk, stereo.
+
+std::optional<std::string_view> SoundDriver_Plan9::Start(const StringList &param)
+{
+	int hz = GetDriverParamInt(param, "hz", 44100);
+	if (p9audio_open(hz) < 0) return "no Plan 9 audio device";
+	_p9_mix.assign(2 * MIX_CHUNK, 0);
+	MxInitialize(hz);
+	return std::nullopt;
+}
+
+void SoundDriver_Plan9::Stop()
+{
+	p9audio_close();
+}
+
+void SoundDriver_Plan9::MainLoop()
+{
+	while (p9audio_space() >= MIX_CHUNK) {
+		MxMixSamples(_p9_mix.data(), MIX_CHUNK);
+		p9audio_write(_p9_mix.data(), MIX_CHUNK);
+	}
+}
