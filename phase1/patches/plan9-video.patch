+/** @file plan9_v.h Base of the Plan 9 video driver. */
+
+#ifndef VIDEO_PLAN9_H
+#define VIDEO_PLAN9_H
+
+#include "video_driver.hpp"
+
+/** The video driver for Plan 9's draw device (libdraw), through a small C shim. */
+class VideoDriver_Plan9 : public VideoDriver {
+public:
+	std::optional<std::string_view> Start(const StringList &param) override;
+
+	void Stop() override;
+
+	void MakeDirty(int left, int top, int width, int height) override;
+
+	void MainLoop() override;
+
+	bool ChangeResolution(int w, int h) override;
+
+	bool ToggleFullscreen(bool fullscreen) override;
+
+	bool AfterBlitterChange() override;
+
+	bool ClaimMousePointer() override;
+
+	std::string_view GetName() const override { return "plan9"; }
+
+protected:
+	void InputLoop() override;
+	void Paint() override;
+	void CheckPaletteAnim() override;
+	bool PollEvent() override;
+
+private:
+	bool CreateMainSurface(int w, int h);
+};
+
+/** Factory for the Plan 9 video driver. */
+class FVideoDriver_Plan9 : public DriverFactoryBase {
+public:
+	FVideoDriver_Plan9() : DriverFactoryBase(Driver::DT_VIDEO, 9, "plan9", "Plan 9 Video Driver") {}
+	std::unique_ptr<Driver> CreateInstance() const override { return std::make_unique<VideoDriver_Plan9>(); }
+};
+
+#endif /* VIDEO_PLAN9_H */
